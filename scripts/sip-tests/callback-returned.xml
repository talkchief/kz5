<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<scenario name="Kazoo local simulated carrier callback answer and confirmation">
  <!-- CSV: exact-fictional-destination;confirmation-delay-ms;bridge-hold-ms -->
  <recv request="INVITE" rrs="true" timeout="90000" crlf="true">
    <action>
      <ereg regexp="INVITE sip:\+12025550101@" search_in="msg" check_it="true" assign_to="uri_match"/>
      <assignstr assign_to="confirm_delay_text" value="[field1]"/>
      <todouble assign_to="confirm_delay_ms" variable="confirm_delay_text"/>
      <assignstr assign_to="bridge_hold_text" value="[field2]"/>
      <todouble assign_to="bridge_hold_ms" variable="bridge_hold_text"/>
    </action>
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 100 Trying
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]carrier[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>
  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_Record-Route:]
      [last_From:]
      [last_To:];tag=[pid]carrier[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[field0]@[local_ip]:[local_port]>;transport=[transport]
      Content-Length: 0
    ]]>
  </send>
  <pause milliseconds="300"/>
  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_Record-Route:]
      [last_From:]
      [last_To:];tag=[pid]carrier[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[field0]@[local_ip]:[local_port]>;transport=[transport]
      Allow: INVITE, ACK, CANCEL, BYE, OPTIONS, INFO, UPDATE
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp [pid] [call_number] IN IP[local_ip_type] [local_ip]
      s=Kazoo local simulated carrier
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0 96
      a=rtpmap:0 PCMU/8000
      a=rtpmap:96 telephone-event/8000
      a=fmtp:96 0-16
      a=sendrecv
    ]]>
  </send>
  <recv request="ACK" rrs="true" timeout="10000" crlf="true">
    <action>
      <!-- Capture the established dialog headers after our To tag has been
           reflected by FreeSWITCH. They are swapped for the UAS-initiated BYE. -->
      <ereg regexp=": *(.*)" search_in="hdr" header="To" assign_to="_,us"/>
      <ereg regexp=": *(.*)" search_in="hdr" header="From" assign_to="_,them"/>
    </action>
  </recv>
  <Reference variables="_,uri_match"/>

  <nop><action><exec rtp_stream="apattern,1,0,PCMU/8000"/></action></nop>
  <pause variable="confirm_delay_ms"/>
  <nop><action><exec play_dtmf="1,200"/></action></nop>
  <!-- Keep the returned caller active while ACDC originates and bridges the
       native agent leg. RTP/call-event evidence is checked by the harness. -->
  <pause variable="bridge_hold_ms"/>
  <nop><action><exec rtp_stream="pauseapattern"/></action></nop>

  <!-- The returned caller is the controlled test endpoint and initiates the
       normal clear after the bounded bridge hold. -->
  <send retrans="500" start_txn="bye">
    <![CDATA[
      BYE [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      [routes]
      Max-Forwards: 70
      From: [$us]
      To: [$them]
      [last_Call-ID:]
      CSeq: 2 BYE
      Contact: <sip:[field0]@[local_ip]:[local_port]>;transport=[transport]
      Content-Length: 0
    ]]>
  </send>
  <recv response="200" response_txn="bye"/>

  <ResponseTimeRepartition value="10,20,50,100,200,500,1000,2000,5000,10000"/>
  <CallLengthRepartition value="1000,5000,10000,15000,20000,30000,60000"/>
</scenario>
