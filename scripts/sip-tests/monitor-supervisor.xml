<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<scenario name="Isolated monitor acceptance endpoint with synthetic tone">
  <recv request="INVITE" rrs="true"/>

  <send>
    <![CDATA[
      SIP/2.0 100 Trying
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_Record-Route:]
      [last_From:]
      [last_To:];tag=[pid]agent[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:acdc-agent@[local_ip]:[local_port]>;transport=[transport]
      Content-Length: 0
    ]]>
  </send>

  <pause milliseconds="500"/>
  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_Record-Route:]
      [last_From:]
      [last_To:];tag=[pid]agent[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:acdc-agent@[local_ip]:[local_port]>;transport=[transport]
      Allow: INVITE, ACK, CANCEL, BYE, OPTIONS, INFO, UPDATE
      Supported: timer, replaces
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp [pid] [call_number] IN IP[local_ip_type] [local_ip]
      s=Kazoo ACDC acceptance agent
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0 96
      a=rtpmap:0 PCMU/8000
      a=rtpmap:96 telephone-event/8000
      a=fmtp:96 0-16
      a=sendrecv
    ]]>
  </send>

  <recv request="ACK"/>
  <nop><action><exec rtp_stream="[field0],-1,0,PCMU/8000"/></action></nop>
  <!-- Attempt the legacy keypad escalation. Backend must keep the authorized mode. -->
  <pause milliseconds="5000"/>
  <nop><action><exec play_dtmf="3,200"/></action></nop>
  <recv request="BYE" timeout="150000"/>
  <nop><action><exec rtp_stream="pause"/></action></nop>
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_Record-Route:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <timewait milliseconds="500"/>
  <ResponseTimeRepartition value="10,20,50,100,200,500,1000,2000"/>
  <CallLengthRepartition value="1000,5000,10000,15000,20000,30000,60000"/>
</scenario>
