+-spec spawn_dispatch(fun(), list(), state()) -> state().
+spawn_dispatch(Fun, Args, State) ->
+    %% A detached dispatcher owns its own child monitors. Keep it alive until
+    %% every responder it starts has finished; do not copy the owner's monitors
+    %% into that private group or synchronously call the owner from a child.
+    ChildState = State#state{dispatch_workers=#{}, failed_dispatches=0},
+    spawn_dispatch_worker(fun run_dispatch/2, [Fun, Args ++ [ChildState]], State).
+
+-spec spawn_dispatch_worker(fun(), list(), state()) -> state().
+spawn_dispatch_worker(Fun, Args, #state{dispatch_workers=Workers}=State) ->
+    {Pid, Ref} = kz_process:spawn_monitor(Fun, Args),
+    State#state{dispatch_workers=Workers#{Ref => Pid}}.
+
+-spec run_dispatch(fun(), list()) -> 'ok'.
+run_dispatch(Fun, Args) ->
+    case erlang:apply(Fun, Args) of
+        {'noreply', #state{dispatch_workers=Workers}} -> await_dispatch_workers(Workers, 0);
+        {'noreply', #state{dispatch_workers=Workers}, _Timeout} -> await_dispatch_workers(Workers, 0);
+        _ -> exit('dispatch_did_not_complete')
+    end.
+
+-spec await_dispatch_workers(map(), non_neg_integer()) -> 'ok'.
+await_dispatch_workers(Workers, 0) when map_size(Workers) =:= 0 -> 'ok';
+await_dispatch_workers(Workers, _Failed) when map_size(Workers) =:= 0 ->
+    exit('responder_did_not_complete');
+await_dispatch_workers(Workers, Failed) ->
+    receive
+        {'DOWN', Ref, 'process', Pid, Reason}
+          when is_map_key(Ref, Workers), map_get(Ref, Workers) =:= Pid ->
+            Failure = case Reason of 'normal' -> 0; _ -> 1 end,
+            await_dispatch_workers(maps:remove(Ref, Workers), Failed+Failure)
+    end.
 
