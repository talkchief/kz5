diff --git a/kazoo_dptools.c b/kazoo_dptools.c
--- a/kazoo_dptools.c
+++ b/kazoo_dptools.c
@@ -31,6 +31,7 @@
  *
  */
 #include "mod_kazoo.h"
+#include "kazoo_intercept.h"
 
