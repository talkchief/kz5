+%% Timestamp is optional in the cdr.report API. Keep every routine in the
+%% save pipeline on the same valid Gregorian timestamp when an older or
+%% incomplete publisher omits it. The interaction timestamp is preferable to
+%% wall clock time because it preserves the call's original MODB month.
+-spec report_timestamp(kz_call_event:payload()) -> kz_time:gregorian_seconds().
+report_timestamp(JObj) ->
+    case kapi_cdr:timestamp(JObj) of
+        'undefined' ->
+            case kapi_cdr:interaction_timestamp(JObj) of
+                'undefined' -> kz_time:now_s();
+                InteractionTimestamp -> InteractionTimestamp
+            end;
+        Timestamp -> Timestamp
+    end.
+
