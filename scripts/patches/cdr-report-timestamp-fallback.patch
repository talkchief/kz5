+%%%-----------------------------------------------------------------------------
+%%% @copyright (C) 2026 2600Hz
+%%% @doc Regression tests for cdr.report timestamp normalization.
+%%% This Source Code Form is subject to the terms of the Mozilla Public
+%%% License, v. 2.0. If a copy of the MPL was not distributed with this
+%%% file, You can obtain one at https://mozilla.org/MPL/2.0/.
+%%%-----------------------------------------------------------------------------
+-module(cdr_report_tests).
+
+-include_lib("eunit/include/eunit.hrl").
+
+-define(TIMESTAMP, 63955782000).
+-define(INTERACTION_TIMESTAMP, 63955781000).
+
+report_timestamp_test_() ->
+    Before = kz_time:now_s(),
+    MissingTimestamp = cdr_report:report_timestamp(kz_json:new()),
+    After = kz_time:now_s(),
+    [{"report Timestamp has precedence"
+     ,?_assertEqual(?TIMESTAMP
+                   ,cdr_report:report_timestamp(
+                      kz_json:from_list([{<<"Timestamp">>, ?TIMESTAMP}
+                                        ,{<<"Call-Interaction">>
+                                         ,kz_json:from_list([{<<"Timestamp">>, ?INTERACTION_TIMESTAMP}])}
+                                        ])))
+     }
+    ,{"interaction Timestamp is used when report Timestamp is absent"
+     ,?_assertEqual(?INTERACTION_TIMESTAMP
+                   ,cdr_report:report_timestamp(
+                      kz_json:from_list([{<<"Call-Interaction">>
+                                         ,kz_json:from_list([{<<"Timestamp">>, ?INTERACTION_TIMESTAMP}])}
+                                        ])))
+     }
+    ,{"current time safely replaces a completely absent Timestamp"
+     ,?_assert(MissingTimestamp >= Before andalso MissingTimestamp =< After)
+     }
+    ].
