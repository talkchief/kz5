diff --git a/submodules/acdc/acdc.js b/submodules/acdc/acdc.js
new file mode 100644
index 0000000..aa69fcb
--- /dev/null
+++ b/submodules/acdc/acdc.js
@@ -0,0 +1,109 @@
+define(function(require) {
+	var $ = require('jquery'),
+		_ = require('lodash'),
+		monster = require('monster');
+
+	var app = {
+		requests: {
+			'callflows.acdc.queues.list': {
+				url: 'accounts/{accountId}/queues?paginate=false',
+				verb: 'GET',
+				generateError: false
+			}
+		},
+
+		subscribe: {
+			'callflows.fetchActions': 'acdcDefineActions'
+		},
+
+		acdcDefineActions: function(args) {
+			var self = this,
+				labels = self.i18n.active().callflows.acdc;
+
+			$.extend(args.actions, {
+				'acdc_member[id=*]': {
+					name: labels.name,
+					icon: 'support',
+					category: self.i18n.active().oldCallflows.advanced_cat,
+					module: 'acdc_member',
+					tip: labels.tip,
+					data: {},
+					rules: [{ type: 'quantity', maxSize: '1' }],
+					isUsable: 'true',
+					isListed: true,
+					weight: 31,
+					caption: function(node, captions) {
+						var id = node.getMetadata('id');
+						return captions && captions[id] && captions[id].name || id || labels.selectQueue;
+					},
+					edit: function(node, callback) {
+						self.acdcEditQueue(node, callback);
+					}
+				}
+			});
+		},
+
+		acdcListQueues: function(callback, error) {
+			var self = this;
+			monster.request({
+				resource: 'callflows.acdc.queues.list',
+				data: { accountId: self.accountId },
+				success: function(response) {
+					if (!response || !_.isArray(response.data) || response.next_start_key) {
+						error();
+						return;
+					}
+					callback(_.sortBy(_.filter(response.data, function(queue) {
+						return queue && typeof queue.id === 'string' && /^[a-f0-9]{32}$/.test(queue.id)
+							&& typeof queue.name === 'string';
+					}), 'name'));
+				},
+				error: error
+			});
+		},
+
+		acdcSelectQueue: function(node, queueId, queues) {
+			var selected = _.find(queues, function(queue) { return queue.id === queueId; });
+			if (!selected || !/^[a-f0-9]{32}$/.test(queueId)) {
+				return false;
+			}
+			node.setMetadata('id', queueId);
+			node.caption = selected.name;
+			return true;
+		},
+
+		acdcEditQueue: function(node, callback) {
+			var self = this,
+				labels = self.i18n.active().callflows.acdc,
+				done = _.once(function() { if (typeof callback === 'function') { callback(); } });
+
+			self.acdcListQueues(function(queues) {
+				var content = $(self.getTemplate({
+						name: 'callflowEdit',
+						data: { items: queues, selected: node.getMetadata('id') || '', empty: queues.length === 0 },
+						submodule: 'acdc'
+					})),
+					dialog;
+
+				content.find('[data-action="save-acdc-queue"]').on('click', function(event) {
+					event.preventDefault();
+					if (!self.acdcSelectQueue(node, content.find('[name="acdc_queue_id"]').val(), queues)) {
+						content.find('[data-role="selection-error"]').show();
+						return;
+					}
+					dialog.dialog('close');
+				});
+				dialog = monster.ui.dialog(content, {
+					title: labels.name,
+					minHeight: '0',
+					beforeClose: done
+				});
+			}, function() {
+				monster.ui.toast({ type: 'error', message: labels.loadError });
+				done();
+			});
+		}
+	};
+
+	return app;
+});
diff --git a/submodules/acdc/views/callflowEdit.html b/submodules/acdc/views/callflowEdit.html
new file mode 100644
index 0000000..3b710af
--- /dev/null
+++ b/submodules/acdc/views/callflowEdit.html
@@ -0,0 +1,25 @@
+<div class="dialog_popup callflows-port">
+	<h1>{{ i18n.callflows.acdc.tip }}</h1>
+	<form name="form" method="post" action="#">
+		<div class="form_content">
+			<div class="popup_field">
+				<label for="acdc_queue_selector">{{ i18n.callflows.acdc.whichQueue }}</label>
+				<div class="select_wrapper">
+					<select id="acdc_queue_selector" name="acdc_queue_id" {{#if empty}}disabled{{/if}}>
+					{{#select selected}}
+						<option value="">{{ i18n.callflows.acdc.selectQueue }}</option>
+						{{#each items}}
+							<option value="{{id}}">{{name}}</option>
+						{{/each}}
+					{{/select}}
+					</select>
+				</div>
+			</div>
+			{{#if empty}}<p role="status">{{ i18n.callflows.acdc.noQueues }}</p>{{/if}}
+			<p data-role="selection-error" role="alert" style="display:none">{{ i18n.callflows.acdc.selectQueue }}</p>
+		</div>
+	</form>
+	<div class="buttons-center">
+		<button type="button" data-action="save-acdc-queue" class="monster-button monster-button-primary" {{#if empty}}disabled{{/if}}>{{ i18n.save }}</button>
+	</div>
+</div>
