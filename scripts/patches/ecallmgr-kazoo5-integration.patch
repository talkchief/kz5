+%% FreeSWITCH's per-file timeout is milliseconds, unlike playback_timeout_sec.
+%% It expires with this file handle; later playback inherits no shortened cap.
+-spec file_playback_timeout(binary(), kz_json:object()) -> binary().
+file_playback_timeout(MediaPath, JObj) ->
+    case {kz_json:get_value(<<"Playback-Timeout-Ms">>, JObj), MediaPath} of
+        {'undefined', _} -> MediaPath;
+        {_, <<"{", _/binary>>} -> throw({'msg', <<"Per-file timeout cannot override existing file parameters">>});
+        {Timeout, _} when is_integer(Timeout), Timeout >= 1, Timeout =< 60000 ->
+            <<"{timeout=", (integer_to_binary(Timeout))/binary, "}", MediaPath/binary>>;
+        _ -> throw({'msg', <<"Invalid per-file playback timeout">>})
+    end.
+
