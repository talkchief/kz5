+    %% Do not catch callback failures as JSON failures.
     case blackhole_socket_callback:recv({Action, Msg}, Context) of
         {'ok', NewContext} -> {'ok', NewContext, 'hibernate'};
         'error' -> {'ok', Context, 'hibernate'}
-    end;
