+websocket_handle({'text', Data}, Context) when is_binary(Data) ->
+    case decode_frame(Data) of
+        {'ok', JObj} -> handle_object(JObj, Context);
+        {'error', Code, Reason} -> {'reply', {'close', Code, Reason}, Context}
+    end;
+websocket_handle('ping', Context) ->
