 -define(TIMEOUT, 5 * ?MILLISECONDS_IN_SECOND).
 
+%% OTP 24 introduced process-alias reply tags for calls to remote processes.
+%% FreeSWITCH's mod_kazoo C-node can reply to the historical reference tag,
+%% but the EI API it uses cannot address an Erlang process alias. Keep the
+%% wire protocol compatible while retaining a bounded timeout.
+-spec call({atom(), atom()}, term()) -> term().
+call(Server, Request) ->
+    call(Server, Request, ?TIMEOUT).
+
+-spec call({atom(), atom()}, term(), timeout()) -> term().
+call(Server, Request, Timeout) ->
+    Tag = make_ref(),
+    Server ! {'$gen_call', {self(), Tag}, Request},
+    receive
+        {Tag, Reply} -> Reply
+    after Timeout ->
+            exit({'timeout', {'gen_server', 'call', [Server, Request, Timeout]}})
+    end.
+
+-spec ping(atom()) -> 'pong' | 'pang'.
+ping(Node) ->
+    case version(Node, ?TIMEOUT) of
+        {'ok', _Version} -> 'pong';
+        _ -> 'pang'
+    end.
+
 -spec version(atom()) -> freeswitch:fs_api_return().
