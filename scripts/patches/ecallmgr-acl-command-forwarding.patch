 -spec get_acls() -> kz_json:object().
+%% SUP defaults to the applications node, which also carries this module but
+%% runs no ecallmgr: a node-scoped ACL was then stored under a node that nothing
+%% reads and the FreeSWITCH reload crashed with noproc, while the command looked
+%% half successful. Run the command where ecallmgr lives instead. Without a
+%% reachable ecallmgr node nothing is written.
+-spec on_ecallmgr(atom(), list(), fun(() -> Result)) -> Result | 'no_return'.
+on_ecallmgr(Function, Args, Local) ->
+    case is_pid(whereis('ecallmgr_fs_nodes')) of
+        'true' -> Local();
+        'false' -> forward_to_ecallmgr(Function, Args, ecallmgr_nodes())
+    end.
+
+%% Already connected nodes plus every node the AMQP node registry advertises as
+%% running ecallmgr: on separate hosts the applications node is normally not
+%% connected to it yet, and the call below connects on demand with the cluster
+%% cookie. Only a node that really runs ecallmgr_fs_nodes is used.
+-spec ecallmgr_nodes() -> [node()].
+ecallmgr_nodes() ->
+    [Node || Node <- lists:usort(nodes() ++ advertised_ecallmgr_nodes()),
+             Node =/= node(),
+             is_pid(rpc:call(Node, 'erlang', 'whereis', ['ecallmgr_fs_nodes'], 5 * ?MILLISECONDS_IN_SECOND))
+    ].
+
+-spec advertised_ecallmgr_nodes() -> [node()].
+advertised_ecallmgr_nodes() ->
+    try [Node || #kz_node{node=Node, kapps=Kapps} <- kz_nodes:nodes(),
+                 is_atom(Node), is_list(Kapps), props:is_defined(?APP_NAME, Kapps)
+        ]
+    catch
+        _:_ -> []
+    end.
+
+-spec forward_to_ecallmgr(atom(), list(), [node()]) -> 'no_return'.
+forward_to_ecallmgr(Function, _Args, []) ->
+    io:format("~s does not run ecallmgr and no connected ecallmgr node was found; nothing was changed.~n"
+              "Start ecallmgr, or run: sup -n ecallmgr ecallmgr_maintenance ~s ...~n", [node(), Function]),
+    'no_return';
+forward_to_ecallmgr(Function, Args, Nodes) ->
+    lists:foreach(fun(Node) ->
+                          io:format("~s does not run ecallmgr; running ~s on ~s~n", [node(), Function, Node]),
+                          case rpc:call(Node, ?MODULE, Function, Args, 60 * ?MILLISECONDS_IN_SECOND) of
+                              {'badrpc', Reason} -> io:format("~s failed on ~s: ~p~n", [Function, Node, Reason]);
+                              _ -> 'ok'
+                          end
+                  end, Nodes),
+    'no_return'.
+
 get_acls() -> get_acls(node()).
 
 -spec get_acls(atom() | kz_term:ne_binary()) -> kz_json:object().
