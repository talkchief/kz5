+
+%% Exception terms, argument values and frame metadata can contain credentials
+%% or entire request contexts. Keep bounded MFA diagnostics only. An exception
+%% in the logging backend must not escape the responder's existing catch path.
+-spec log_binding_exception(atom(), module(), responder_fun(), non_neg_integer(), any()) -> 'ok'.
+log_binding_exception(Class, M, F, Arity, ST) ->
+    try lager:error("binding responder failure (~p): ~p; frames: ~p"
+                   ,[Class, {diagnostic_name(M), diagnostic_name(F), diagnostic_arity(Arity)}
+                    ,diagnostic_frames(ST, 8)])
+    catch _:_ -> 'ok' end,
+    'ok'.
+
+-spec diagnostic_name(any()) -> atom().
+diagnostic_name(Name) when is_atom(Name) -> Name;
+diagnostic_name(_) -> 'anonymous'.
+
+-spec diagnostic_arity(any()) -> non_neg_integer() | 'unknown'.
+diagnostic_arity(Arity) when is_integer(Arity), Arity >= 0, Arity =< 255 -> Arity;
+diagnostic_arity(Args) -> diagnostic_arg_count(Args, 0).
+
+-spec diagnostic_arg_count(any(), non_neg_integer()) -> non_neg_integer() | 'unknown'.
+diagnostic_arg_count([], N) -> N;
+diagnostic_arg_count([_|Rest], N) when N < 255 -> diagnostic_arg_count(Rest, N + 1);
+diagnostic_arg_count(_, _) -> 'unknown'.
+
+-spec diagnostic_frames(any(), non_neg_integer()) -> list().
+diagnostic_frames(_, 0) -> [];
+diagnostic_frames([{M, F, Args, _}|Rest], N) ->
+    [{diagnostic_name(M), diagnostic_name(F), diagnostic_arity(Args)}|diagnostic_frames(Rest, N - 1)];
+diagnostic_frames([{M, F, Args}|Rest], N) ->
+    [{diagnostic_name(M), diagnostic_name(F), diagnostic_arity(Args)}|diagnostic_frames(Rest, N - 1)];
+diagnostic_frames([_|Rest], N) -> ['unknown'|diagnostic_frames(Rest, N - 1)];
+diagnostic_frames(_, _) -> [].
 
