 -spec play_v(kz_term:api_terms()) -> boolean().
+play_v(Req) when is_list(Req) -> play_v(kz_json:from_list(Req));
 play_v(Req) ->
-    kapi_definition:validate(Req, play_definition()).
+    kapi_definition:validate(Req, play_definition())
+        andalso play_file_timeout_v(Req).
+
+%% The millisecond cap applies to one file handle and never changes channel
+%% variables. Mixing it with global timeouts or repeated playback is ambiguous.
+-spec play_file_timeout_v(kz_json:object()) -> boolean().
+play_file_timeout_v(Req) ->
+    case kz_json:get_value(<<"Playback-Timeout-Ms">>, Req) of
+        'undefined' -> 'true';
+        _ -> kz_json:get_value(<<"Playback-Timeout">>, Req) =:= 'undefined'
+            andalso kz_json:get_value(<<"Loop-Count">>, Req) =:= 'undefined'
+            andalso not kz_json:is_true(<<"Endless-Playback">>, Req, 'false')
+    end.
 
