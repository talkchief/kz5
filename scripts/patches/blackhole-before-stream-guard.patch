diff --git a/src/modules/bh_queue_live.erl b/src/modules/bh_queue_live.erl
new file mode 100644
--- /dev/null
+++ b/src/modules/bh_queue_live.erl
@@ -0,0 +1,255 @@
+%%% SPDX-License-Identifier: MPL-2.0
+%%% Lossy queue invalidation hints, never snapshots or queue positions.
+%%% Token/DB authorization runs outside the websocket mailbox. Credentials
+%%% are never put into binding payloads; only the session owns pending state.
+-module(bh_queue_live).
+-export([init/0, authorize/2, validate/2, bindings/2, event/3,
+         handle/3, info/2, close/1]).
+-include("blackhole.hrl").
+-define(AUTH_MS, 3000).
+-define(MAX_QUEUES, 100).
+
+-spec init() -> ok.
+init() ->
+    _=blackhole_bindings:bind(<<"blackhole.events.authorize.queue_live">>,?MODULE,authorize),
+    _=blackhole_bindings:bind(<<"blackhole.events.validate.queue_live">>,?MODULE,validate),
+    _=blackhole_bindings:bind(<<"blackhole.events.bindings.queue_live">>,?MODULE,bindings),
+    _=blackhole_bindings:bind(<<"blackhole.session.close">>,?MODULE,close),ok.
+
+%% Generic subscription dispatch cannot bypass the asynchronous fresh-token
+%% admission below by trusting an old Blackhole auth_account_id.
+-spec authorize(bh_context:context(), map()) -> bh_context:context().
+authorize(C,_) -> bh_context:add_error(C,<<"queue_live requires fresh asynchronous authorization">>).
+-spec validate(bh_context:context(), map()) -> bh_context:context().
+validate(C,#{account_id:=A,keys:=[<<"changed">>,Q]}) ->
+    case id(A) andalso id(Q) of true->C; false->bh_context:add_error(C,<<"invalid queue_live scope">>) end;
+validate(C,_) -> bh_context:add_error(C,<<"invalid queue_live binding">>).
+-spec bindings(bh_context:context(), map()) -> map() | bh_context:context().
+bindings(C,#{account_id:=A,keys:=[<<"changed">>,Q]}=M) ->
+    case id(A) andalso id(Q) of
+        true -> M#{requested=>client(Q),subscribed=>[route(A,Q)],module=>?MODULE,
+            listeners=>[{amqp,acdc_dashboard_events,[{account_id,A},{queue_id,Q},federate]}]};
+        false -> bh_context:add_error(C,<<"invalid queue_live scope">>)
+    end;
+bindings(C,_) -> bh_context:add_error(C,<<"invalid queue_live binding">>).
+
+-spec handle(binary(), kz_json:object(), bh_context:context()) -> pass | tuple().
+handle(Action,Payload,C) ->
+    case has_namespace(Payload) of
+        false -> pass;
+        true ->
+            RequestId=request_id(Payload),
+            case request(Action,Payload,C) of
+                {ok,A,Q,Token} ->
+                    Next=bh_context:set_auth_token(C,Token),
+                    case kz_buckets:consume_token(?APP_NAME,bh_context:websocket_session_id(C)) of
+                        true -> command(Action,A,Q,RequestId,Next);
+                        false -> reply(error,RequestId,<<"rate limited">>,Next)
+                    end;
+                error -> reply(error,RequestId,<<"invalid queue_live request">>,C)
+            end
+    end.
+
+has_namespace(P) ->
+    namespace(kz_json:get_value([<<"data">>,<<"binding">>],P)) orelse
+        namespace_list(kz_json:get_value([<<"data">>,<<"bindings">>],P),101).
+namespace(<<"queue_live">>) -> true;
+namespace(<<"queue_live.",_/binary>>) -> true;
+namespace(_) -> false.
+%% Oversized unrelated lists stay on the ordinary path. A queue_live binding
+%% hidden after this bound still cannot pass our generic authorize/2 callback.
+namespace_list(_,0) -> false;
+namespace_list([B|Rest],N) -> namespace(B) orelse namespace_list(Rest,N-1);
+namespace_list(_,_) -> false.
+request(Action,P,C) when Action=:= <<"subscribe">>; Action=:= <<"unsubscribe">> ->
+    A=kz_json:get_value([<<"data">>,<<"account_id">>],P),
+    B=case {kz_json:get_value([<<"data">>,<<"binding">>],P),
+            kz_json:get_value([<<"data">>,<<"bindings">>],P)} of
+          {One,undefined} -> One;
+          {undefined,[One]} -> One;
+          _ -> undefined
+      end,
+    Token=kz_json:get_value(<<"auth_token">>,P,bh_context:auth_token(C)),
+    case B of
+        <<"queue_live.changed.",Q/binary>> ->
+            case id(A) andalso id(Q) andalso is_binary(Token) andalso
+                byte_size(Token)>0 andalso byte_size(Token)=<16384 of
+                true -> {ok,A,Q,Token}; false -> error
+            end;
+        _ -> error
+    end;
+request(_,_,_) -> error.
+request_id(P) ->
+    case kz_json:get_value(<<"request_id">>,P) of
+        B when is_binary(B),byte_size(B)>0,byte_size(B)=<128 -> B;
+        _ -> <<"queue_live">>
+    end.
+
+command(<<"subscribe">>,A,Q,RequestId,C) ->
+    S=state(C),Members=maps:get(members,S),
+    case {maps:get(worker,S),maps:is_key({A,Q},Members) orelse map_size(Members)<?MAX_QUEUES} of
+        {undefined,true} -> {ok,start(subscribe,A,Q,make_ref(),RequestId,C)};
+        {_,false} -> reply(error,RequestId,<<"queue_live subscription limit">>,C);
+        _ -> reply(error,RequestId,<<"queue_live authorization busy">>,C)
+    end;
+command(<<"unsubscribe">>,A,Q,RequestId,C) ->
+    S=state(C),
+    %% Cancel a pending subscribe/delivery for this exact scope before removing
+    %% membership. A later result cannot recreate or emit that subscription.
+    {Next,Cancelled}=case maps:get(worker,S) of
+             #{account:=A,queue:=Q,kind:=subscribe,request_id:=Pending}=W ->
+                 cancel_worker(W),{put_state(C,S#{worker:=undefined}),Pending};
+             #{account:=A,queue:=Q}=W ->
+                 cancel_worker(W),{put_state(C,S#{worker:=undefined}),undefined};
+             _ -> {C,undefined}
+         end,
+    S1=state(Next),
+    Unbound=bh_events:unsubscribe(Next,payload(A,Q)),
+    S2=S1#{members:=maps:remove({A,Q},maps:get(members,S1)),
+           dirty:=[K || K={DA,DQ,_}<-maps:get(dirty,S1),{DA,DQ}=/={A,Q}]},
+    Done=next(put_state(Unbound,S2)),
+    Reply=reply_data(success,RequestId,bh_context:resp_data(Unbound),bh_context:set_resp_data(Done,undefined)),
+    case Cancelled of
+        undefined -> Reply;
+        _ ->
+            {reply,CancelledFrame,_}=reply(error,Cancelled,<<"queue_live authorization cancelled">>,C),
+            {reply,Frame,Final}=Reply,
+            {reply,[CancelledFrame,Frame],Final}
+    end.
+
+state(C) -> maps:merge(#{members=>#{},dirty=>[],worker=>undefined},bh_context:queue_live_state(C)).
+put_state(C,S) -> bh_context:set_queue_live_state(C,S).
+start(Kind,A,Q,Generation,RequestId,C) ->
+    Parent=self(),Ref=make_ref(),Token=bh_context:auth_token(C),
+    Deadline=erlang:monotonic_time(millisecond)+?AUTH_MS,
+    {Pid,Monitor}=spawn_monitor(fun() ->
+        %% Independent watchdog also bounds an orphan if its socket dies
+        %% without running terminate/3. No token enters timer/result messages.
+        {ok,Watchdog}=timer:kill_after(?AUTH_MS,self()),
+        Result=try acdc_live_auth:fresh_token(Token,A,Q) of
+                   {ok,Auth} ->
+                       Account=cb_context:auth_account_id(Auth),
+                       case id(Account) of true->{ok,Account}; false->denied end;
+                   _ -> denied
+               catch _:_ -> denied end,
+        timer:cancel(Watchdog),Parent!{queue_live_result,Ref,Result}
+    end),
+    Timer=erlang:send_after(?AUTH_MS,self(),{queue_live_timeout,Ref}),
+    W=#{pid=>Pid,monitor=>Monitor,timer=>Timer,ref=>Ref,deadline=>Deadline,
+        token_hash=>digest(Token),auth_account=>bh_context:auth_account_id(C),
+        kind=>Kind,account=>A,queue=>Q,
+        generation=>Generation,request_id=>RequestId},
+    put_state(C,(state(C))#{worker:=W}).
+
+-spec info(term(), bh_context:context()) -> pass | tuple().
+info({queue_live_dirty,A,Q},C) ->
+    S=state(C),
+    case maps:find({A,Q},maps:get(members,S)) of
+        {ok,{G,_}} ->
+            Dirty=maps:get(dirty,S),Key={A,Q,G},
+            case member(A,Q,G,C) andalso not lists:member(Key,Dirty) andalso length(Dirty)<?MAX_QUEUES of
+                true -> {ok,next(put_state(C,S#{dirty:=Dirty++[Key]}))};
+                false -> {ok,C}
+            end;
+        error -> {ok,C}
+    end;
+info({queue_live_result,Ref,Result},C) ->
+    case maps:get(worker,state(C)) of
+        #{ref:=Ref}=W ->
+            clear_worker(W),
+            Clean=put_state(C,(state(C))#{worker:=undefined}),
+            Valid=erlang:monotonic_time(millisecond)<maps:get(deadline,W) andalso
+                maps:get(token_hash,W)=:=digest(bh_context:auth_token(C)) andalso
+                maps:get(auth_account,W)=:=bh_context:auth_account_id(C),
+            finish(W,case Valid of true->Result; false->denied end,Clean);
+        _ -> {ok,C}
+    end;
+info({queue_live_timeout,Ref},C) ->
+    case maps:get(worker,state(C)) of
+        #{ref:=Ref}=W ->
+            cancel_worker(W),finish(W,denied,put_state(C,(state(C))#{worker:=undefined}));
+        _ -> {ok,C}
+    end;
+info({'DOWN',Monitor,process,_,_},C) ->
+    case maps:get(worker,state(C)) of
+        #{monitor:=Monitor}=W ->
+            clear_worker(W),finish(W,denied,put_state(C,(state(C))#{worker:=undefined}));
+        _ -> pass
+    end;
+info(_,_) -> pass.
+
+finish(#{kind:=subscribe,account:=A,queue:=Q,generation:=G,request_id:=Req},{ok,AuthAccount},C) ->
+    %% Equivalent stronger live/stats/queue authorization already ran in the
+    %% worker. Do not rerun generic hierarchy checks using stale identity.
+    New=bh_events:subscribe(bh_context:set_auth_account_id(C,AuthAccount),payload(A,Q)),
+    case bh_context:success(New) andalso lists:member({client(Q),[route(A,Q)]},bh_context:bindings(New)) of
+        true ->
+            S=state(New),Members=maps:put({A,Q},{G,AuthAccount},maps:get(members,S)),
+            Done=next(put_state(New,S#{members:=Members})),
+            reply_data(success,Req,bh_context:resp_data(New),bh_context:set_resp_data(Done,undefined));
+        false -> reply(error,Req,<<"queue_live binding unavailable">>,next(C))
+    end;
+finish(#{kind:=subscribe,request_id:=Req},_,C) -> reply(error,Req,<<"queue_live authorization denied">>,next(C));
+finish(#{kind:=delivery,account:=A,queue:=Q,generation:=G},{ok,AuthAccount},C) ->
+    case member(A,Q,G,C) andalso AuthAccount=:=bh_context:auth_account_id(C) of
+        true ->
+            %% Return the native event frame directly to Cowboy. A delayed
+            %% send_data message could otherwise outlive a token/unsubscribe
+            %% command queued between authorization and socket output.
+            Envelope=kz_json:from_list([{<<"action">>,<<"event">>},{<<"name">>,<<"changed">>},
+                {<<"subscribed_key">>,client(Q)},{<<"subscription_key">>,route(A,Q)},
+                {<<"routing_key">>,route(A,Q)},
+                {<<"data">>,kz_json:from_list([{<<"version">>,1},{<<"account_id">>,A},{<<"queue_id">>,Q}])}]),
+            {reply,{text,kz_json:encode(Envelope)},next(C)};
+        false -> {ok,next(C)}
+    end;
+finish(_,_,C) -> {ok,next(C)}.
+
+next(C) ->
+    S=state(C),
+    case {maps:get(worker,S),maps:get(dirty,S)} of
+        {undefined,[{A,Q,G}|Rest]} ->
+            Clean=put_state(C,S#{dirty:=Rest}),
+            case member(A,Q,G,C) of true->start(delivery,A,Q,G,undefined,Clean); false->next(Clean) end;
+        _ -> C
+    end.
+member(A,Q,G,C) ->
+    Key={client(Q),[route(A,Q)]},
+    maps:get({A,Q},maps:get(members,state(C)),undefined)=:={G,bh_context:auth_account_id(C)} andalso
+        lists:member(Key,bh_context:bindings(C)) andalso
+        case maps:get(Key,bh_context:binding_resources(C),undefined) of {?MODULE,_}->true; _->false end.
+clear_worker(W) ->
+    erlang:cancel_timer(maps:get(timer,W)),erlang:demonitor(maps:get(monitor,W),[flush]),ok.
+cancel_worker(W) -> clear_worker(W),exit(maps:get(pid,W),kill),ok.
+-spec close(bh_context:context()) -> bh_context:context().
+close(C) ->
+    case maps:get(worker,state(C)) of undefined->ok; W->cancel_worker(W) end,
+    bh_context:set_queue_live_state(C,#{}).
+
+-spec event(map(), binary(), kz_json:object()) -> ok.
+event(#{session_pid:=Pid,subscribed_key:=Client,subscription_key:=RK},RK,J) ->
+    try
+        A=kz_json:get_value(<<"Account-ID">>,J),Q=kz_json:get_value(<<"Queue-ID">>,J),
+        case kapi_acdc_dashboard_events:changed_v(J) andalso id(A) andalso id(Q) andalso
+            RK=:=route(A,Q) andalso Client=:=client(Q) of
+            true ->
+                case process_info(Pid,message_queue_len) of
+                    {message_queue_len,N} when N=<50 -> Pid!{queue_live_dirty,A,Q},ok;
+                    _ -> ok
+                end;
+            false -> ok
+        end
+    catch _:_ -> ok end;
+event(_,_,_) -> ok.
+payload(A,Q) -> kz_json:from_list([{<<"data">>,kz_json:from_list([{<<"account_id">>,A},{<<"binding">>,client(Q)}])}]).
+reply(error,Req,Message,C) -> reply_data(error,Req,kz_json:from_list([{<<"errors">>,[Message]}]),C).
+reply_data(Status,Req,Data,C) ->
+    J=kz_json:from_list([{<<"action">>,<<"reply">>},{<<"request_id">>,Req},
+        {<<"status">>,atom_to_binary(Status,utf8)},{<<"data">>,Data}]),
+    {reply,{text,kz_json:encode(J)},C}.
+digest(B) when is_binary(B) -> crypto:hash(sha256,B);
+digest(_) -> undefined.
+id(B) when is_binary(B),byte_size(B)=:=32 -> re:run(B,<<"^[0-9a-f]{32}$">>,[{capture,none}])=:=match;
+id(_) -> false.
+client(Q) -> <<"queue_live.changed.",Q/binary>>.
+route(A,Q) -> <<"acdc.dashboard.changed.",A/binary,".",Q/binary>>.
