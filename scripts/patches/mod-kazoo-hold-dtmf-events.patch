+/* Dequeuing input emits FreeSWITCH's DTMF event. Without input arguments,
+ * endless playback leaves digits queued until hangup, so Kazoo cannot react
+ * to a queue exit key or callback request while music is playing. Keep the
+ * playback running; the owning Kazoo controller decides when to interrupt it.
+ */
+static switch_status_t kz_endless_playback_input(switch_core_session_t *session,
+                                                void *input,
+                                                switch_input_type_t input_type,
+                                                void *buffer,
+                                                unsigned int buffer_length)
+{
+    (void) session;
+    (void) input;
+    (void) input_type;
+    (void) buffer;
+    (void) buffer_length;
+    return SWITCH_STATUS_SUCCESS;
+}
+
