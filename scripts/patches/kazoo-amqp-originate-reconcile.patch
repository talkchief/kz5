+%% An originate transaction is a FreeSWITCH-owned resource, independent of the
+%% ephemeral ecallmgr process that launched it. Both IDs are immutable original
+%% request values; Msg-ID remains the fresh query correlation ID.
+-spec originate_reconcile_req_definition() -> kapi_definition:api().
+originate_reconcile_req_definition() ->
+    EventName = <<"originate_reconcile_req">>,
+    Category = <<"channel">>,
+    Required = [<<"Originate-UUID">>, <<"Originate-Request-ID">>
+               ,<<"Outbound-Call-ID">>, <<"Operation">>],
+    Setters = [{fun kapi_definition:set_name/2, EventName}
+              ,{fun kapi_definition:set_friendly_name/2, <<"Originate Reconcile Request">>}
+              ,{fun kapi_definition:set_description/2
+               ,<<"Query or cancel an exactly correlated FreeSWITCH originate transaction">>}
+              ,{fun kapi_definition:set_category/2, Category}
+              ,{fun kapi_definition:set_build_fun/2, fun originate_reconcile_req/1}
+              ,{fun kapi_definition:set_validate_fun/2, fun originate_reconcile_req_v/1}
+              ,{fun kapi_definition:set_publish_fun/2, fun publish_originate_reconcile_req/1}
+              ,{fun kapi_definition:set_binding/2, fun query_routing_key/2}
+              ,{fun kapi_definition:set_required_headers/2, Required}
+              ,{fun kapi_definition:set_optional_headers/2, []}
+              ,{fun kapi_definition:set_values/2
+               ,[{<<"Operation">>, [<<"status">>, <<"cancel">>]}
+                | kapi_definition:event_type_headers(Category, EventName)]}
+              ,{fun kapi_definition:set_types/2
+               ,[{Key, fun kz_term:is_ne_binary/1} || Key <- Required]}
+              ],
+    kapi_definition:setters(Setters).
+
+-spec originate_reconcile_resp_definition() -> kapi_definition:api().
+originate_reconcile_resp_definition() ->
+    EventName = <<"originate_reconcile_resp">>,
+    Category = <<"channel">>,
+    Required = [<<"Originate-UUID">>, <<"Originate-Request-ID">>
+               ,<<"Outbound-Call-ID">>, <<"Operation">>, <<"Status">>],
+    Setters = [{fun kapi_definition:set_name/2, EventName}
+              ,{fun kapi_definition:set_friendly_name/2, <<"Originate Reconcile Response">>}
+              ,{fun kapi_definition:set_description/2
+               ,<<"Authoritative per-ecallmgr originate lifecycle observation">>}
+              ,{fun kapi_definition:set_category/2, Category}
+              ,{fun kapi_definition:set_build_fun/2, fun originate_reconcile_resp/1}
+              ,{fun kapi_definition:set_validate_fun/2, fun originate_reconcile_resp_v/1}
+              ,{fun kapi_definition:set_publish_fun/2, fun publish_originate_reconcile_resp/2}
+              ,{fun kapi_definition:set_required_headers/2, Required}
+              ,{fun kapi_definition:set_optional_headers/2
+               ,[<<"Media-Node">>, <<"Module-Epoch">>, <<"Outcome">>
+                ,<<"Result-Call-ID">>, <<"Failure-Cause">>, <<"Detail">>]}
+              ,{fun kapi_definition:set_values/2
+               ,[{<<"Operation">>, [<<"status">>, <<"cancel">>]}
+                ,{<<"Status">>, [<<"pending">>, <<"settled">>, <<"unknown">>]}
+                ,{<<"Outcome">>, [<<"success">>, <<"failure">>]}
+                | kapi_definition:event_type_headers(Category, EventName)]}
+              ,{fun kapi_definition:set_types/2
+               ,[{Key, fun kz_term:is_ne_binary/1} || Key <- Required]
+                ++ [{Key, fun kz_term:is_ne_binary/1}
+                    || Key <- [<<"Media-Node">>, <<"Module-Epoch">>, <<"Outcome">>
+                              ,<<"Result-Call-ID">>, <<"Failure-Cause">>, <<"Detail">>]]}
+              ],
+    kapi_definition:setters(Setters).
+
 
