+%%------------------------------------------------------------------------------
+%% @doc Query or cancel a correlated FreeSWITCH originate transaction.
+%% @end
+%%------------------------------------------------------------------------------
+-spec originate_reconcile_req(kz_term:api_terms()) -> kz_api:api_formatter_return().
+originate_reconcile_req(Req) ->
+    kapi_definition:build_message(Req, originate_reconcile_req_definition()).
+
+-spec originate_reconcile_req_v(kz_term:api_terms()) -> boolean().
+originate_reconcile_req_v(Req) ->
+    kapi_definition:validate(Req, originate_reconcile_req_definition()).
+
+-spec publish_originate_reconcile_req(kz_term:api_terms()) -> 'ok'.
+publish_originate_reconcile_req(Req) ->
+    publish_originate_reconcile_req(Req, ?DEFAULT_CONTENT_TYPE).
+
+-spec publish_originate_reconcile_req(kz_term:api_terms(), kz_term:ne_binary()) -> 'ok'.
+publish_originate_reconcile_req(Req, ContentType) ->
+    Definition = originate_reconcile_req_definition(),
+    {'ok', Payload} = kz_api:prepare_api_payload(Req
+                                                ,kapi_definition:values(Definition)
+                                                ,kapi_definition:build_fun(Definition)),
+    kz_amqp_util:channels_publish((kapi_definition:binding(Definition))('status_req', <<"originate">>)
+                                 ,Payload, ContentType).
+
+-spec originate_reconcile_resp(kz_term:api_terms()) -> kz_api:api_formatter_return().
+originate_reconcile_resp(Resp) ->
+    kapi_definition:build_message(Resp, originate_reconcile_resp_definition()).
+
+-spec originate_reconcile_resp_v(kz_term:api_terms()) -> boolean().
+originate_reconcile_resp_v(Resp) ->
+    kapi_definition:validate(Resp, originate_reconcile_resp_definition()).
+
+-spec publish_originate_reconcile_resp(kz_term:ne_binary(), kz_term:api_terms()) -> 'ok'.
+publish_originate_reconcile_resp(RespQ, Resp) ->
+    publish_originate_reconcile_resp(RespQ, Resp, ?DEFAULT_CONTENT_TYPE).
+
+-spec publish_originate_reconcile_resp(kz_term:ne_binary(), kz_term:api_terms(), kz_term:ne_binary()) -> 'ok'.
+publish_originate_reconcile_resp(RespQ, Resp, ContentType) ->
+    Definition = originate_reconcile_resp_definition(),
+    {'ok', Payload} = kz_api:prepare_api_payload(Resp
+                                                ,kapi_definition:values(Definition)
+                                                ,kapi_definition:build_fun(Definition)),
+    kz_amqp_util:targeted_publish(RespQ, Payload, ContentType).
+
