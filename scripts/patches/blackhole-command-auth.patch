+    %% A cached connection identity is not proof that its token is still valid.
+    %% Keep resource-specific authentication hooks, but require fresh token proof
+    %% and a positive context result; missing/crashed handlers cannot grant access.
+    case validate_command_token(bh_context:auth_token(Context)) of
+        {'ok', AccountId} ->
+            case bh_context:auth_account_id(Context) of
+                'undefined' -> authenticate_handlers(Context, Action, Payload, AccountId);
+                AccountId -> authenticate_handlers(Context, Action, Payload, AccountId);
+                _ -> bh_context:add_error(Context, <<"authentication identity changed; reconnect">>)
+            end;
+        'error' -> bh_context:add_error(Context, <<"failed to authenticate token">>)
+    end.
+
+validate_command_token(Token) when is_binary(Token), Token =/= <<>> ->
+    try kz_auth:validate_token(Token) of
+        {'ok', Claims} ->
+            case kz_json:get_ne_binary_value(<<"account_id">>, Claims) of
+                AccountId when is_binary(AccountId), AccountId =/= <<>> -> {'ok', AccountId};
+                _ -> 'error'
+            end;
+        _ -> 'error'
+    catch _:_ -> 'error'
+    end;
+validate_command_token(_) -> 'error'.
+
+authenticate_handlers(Context, Action, Payload, AccountId) ->
+    Routing = <<"blackhole.authenticate.", Action/binary>>,
+    Verified = bh_context:set_authorized(bh_context:set_auth_account_id(Context, AccountId)),
+    Results = blackhole_bindings:map(Routing, [Verified, Payload]),
+    case blackhole_bindings:succeeded(Results) of
+        [] -> bh_context:add_error(Context, <<"authentication handler unavailable or denied">>);
+        _ ->
+            Result = handle_result(Verified, Results),
+            case bh_context:is_context(Result) of
+                'true' ->
+                    case bh_context:auth_account_id(Result) =:= AccountId of
+                        'true' -> Result;
+                        'false' -> bh_context:add_error(Context, <<"authentication identity mismatch">>)
+                    end;
+                'false' -> bh_context:add_error(Context, <<"invalid authentication result">>)
+            end
     end.
 
