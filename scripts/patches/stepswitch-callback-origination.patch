+%% Keep requested event delivery consistent with the bridge and local-extension
+%% offnet paths. Callback workers depend on these events for the returned leg;
+%% this does not authorize or select a route.
+-spec originate_b_leg_events(kapi_offnet_resource:req()) -> kz_term:binaries().
+originate_b_leg_events(OffnetReq) ->
+    kapi_offnet_resource:b_leg_events(OffnetReq, []).
+
+%% READY is a non-terminal barrier when Originate-Immediate is false.  The
+%% listener must remain alive so ecallmgr can deliver the final originate_resp
+%% to the same ephemeral queue after the requestor sends originate_execute.
+-spec originate_result_action(kz_term:proplist()) -> 'retain' | 'stop'.
+originate_result_action(Props) ->
+    case props:get_value(<<"Response-Message">>, Props) of
+        <<"READY">> -> 'retain';
+        _ -> 'stop'
+    end.
+
