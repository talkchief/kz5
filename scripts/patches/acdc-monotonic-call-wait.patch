-wait_for_bridge(#member_call{call=Call}=MC, Timeout, Start) ->
+wait_for_bridge(#member_call{call=Call, max_wait=MaxWait}=MC, Timeout, Start) ->
     Wait = kz_time:start_time(),
-    TimeoutMs = case Timeout of
-                    'infinity' -> 'infinity';
