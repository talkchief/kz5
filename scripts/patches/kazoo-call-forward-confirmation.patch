diff --git a/kazoo_media/src/kz_call_forward_confirmation.erl b/kazoo_media/src/kz_call_forward_confirmation.erl
new file mode 100644
--- /dev/null
+++ b/kazoo_media/src/kz_call_forward_confirmation.erl
@@ -0,0 +1,112 @@
+%%% Account-scoped selection of immutable forwarded-call confirmation media.
+%%% SPDX-License-Identifier: MPL-2.0
+-module(kz_call_forward_confirmation).
+
+-export([select/2, builtin/1, ready/1, available_languages/0, assets/0]).
+-ifdef(TEST).
+-export([select_with/4, builtin_with/2, valid_media/2]).
+-endif.
+
+-include("call_forward_confirmation_assets.hrl").
+-define(DB, <<"system_media">>).
+-define(OWNER, <<"kazoo5_call_forward_confirmation_v1">>).
+
+-spec assets() -> [tuple()].
+assets() -> ?CFWD_CONFIRMATION_ASSETS.
+
+-spec select(binary() | undefined, fun(() -> any())) -> any().
+select(AccountId, Legacy) ->
+    select_with(AccountId, Legacy, fun kzd_accounts:fetch/1, fun read_media/1).
+
+-spec select_with(any(), function(), function(), function()) -> any().
+select_with(AccountId, Legacy, ReadAccount, ReadMedia) ->
+    Result = try
+                 case ReadAccount(AccountId) of
+                     {ok, Account} ->
+                         case kzd_accounts:call_forward_confirmation_language(Account) of
+                             undefined -> legacy;
+                             Language -> builtin_with(Language, ReadMedia)
+                         end;
+                     _ -> {error, account_unavailable}
+                 end
+             catch _:_ -> {error, lookup_failed}
+             end,
+    case Result of
+        {ok, Path} -> Path;
+        legacy -> Legacy();
+        {error, _} ->
+            lager:warning("forwarded-call confirmation lookup failed; retaining legacy prompt and keypress"),
+            Legacy()
+    end.
+
+-spec builtin(any()) -> {ok, binary()} | {error, atom()}.
+builtin(Language) -> builtin_with(Language, fun read_media/1).
+
+-spec builtin_with(any(), function()) -> {ok, binary()} | {error, atom()}.
+builtin_with(Language, Read) ->
+    case lists:keyfind(Language, 1, assets()) of
+        false -> {error, unsupported_language};
+        Asset ->
+            Id = element(2, Asset),
+            try
+                case valid_media(Asset, Read(Id)) of
+                    true -> {ok, <<"/system_media/", Id/binary>>};
+                    false -> {error, media_unavailable}
+                end
+            catch _:_ -> {error, media_unavailable}
+            end
+    end.
+
+%% Used on an explicit preference change. Calls use cached metadata; saving
+%% checks fresh metadata AND attachment bytes against the compiled release.
+-spec ready(any()) -> boolean().
+ready(Language) ->
+    case lists:keyfind(Language, 1, assets()) of
+        false -> false;
+        {_, Id, Prompt, Sha, _, Length, _} = Asset ->
+            try
+                true = valid_media(Asset, kz_datamgr:open_doc(?DB, Id, [{conflicts, true}])),
+                {ok, Bytes} = kz_datamgr:fetch_attachment(?DB, Id, <<Prompt/binary, ".wav">>),
+                byte_size(Bytes) =:= Length andalso kz_binary:hexencode(crypto:hash(sha256, Bytes)) =:= Sha
+            catch _:_ -> false
+            end
+    end.
+
+-spec available_languages() -> [binary()].
+available_languages() -> [L || {L, _, _, _, _, _, _} <- assets(), {ok, _} <- [builtin(L)]].
+
+-spec read_media(binary()) -> any().
+read_media(Id) -> kz_datamgr:open_cache_doc(?DB, Id).
+
+-spec valid_media(tuple(), any()) -> boolean().
+valid_media({Language, Id, Prompt, Sha, Md5, Length, Transcript}, {ok, Doc}) ->
+    Voice = kz_json:get_json_value(<<"source_voice">>, Doc, kz_json:new()),
+    Atts = kz_json:get_json_value(<<"_attachments">>, Doc, kz_json:new()),
+    Name = <<Prompt/binary, ".wav">>,
+    Att = kz_json:get_json_value(Name, Atts, kz_json:new()),
+    get(<<"_id">>, Doc) =:= Id
+        andalso is_binary(get(<<"_rev">>, Doc))
+        andalso lists:member(get(<<"_deleted">>, Doc), [undefined, false])
+        andalso lists:member(get(<<"pvt_deleted">>, Doc), [undefined, false])
+        andalso kz_json:get_value(<<"_conflicts">>, Doc, []) =:= []
+        andalso get(<<"pvt_type">>, Doc) =:= <<"media">>
+        andalso get(<<"pvt_account_db">>, Doc) =:= ?DB
+        andalso get(<<"source_type">>, Doc) =:= ?OWNER
+        andalso get(<<"prompt_id">>, Doc) =:= Prompt
+        andalso get(<<"language">>, Doc) =:= Language
+        andalso get(<<"content_type">>, Doc) =:= <<"audio/wav">>
+        andalso get(<<"content_length">>, Doc) =:= Length
+        andalso get(<<"streamable">>, Doc) =:= true
+        andalso get(<<"provider">>, Voice) =:= <<"google-gemini">>
+        andalso get(<<"model">>, Voice) =:= <<"gemini-2.5-pro-preview-tts">>
+        andalso get(<<"voice">>, Voice) =:= <<"Sulafat">>
+        andalso get(<<"sha256">>, Voice) =:= Sha
+        andalso get(<<"transcript_sha256">>, Voice) =:= Transcript
+        andalso kz_json:get_keys(Atts) =:= [Name]
+        andalso get(<<"content_type">>, Att) =:= <<"audio/wav">>
+        andalso get(<<"digest">>, Att) =:= Md5
+        andalso get(<<"length">>, Att) =:= Length;
+valid_media(_, _) -> false.
+
+-spec get(binary(), any()) -> any().
+get(Key, Doc) -> kz_json:get_value(Key, Doc).
