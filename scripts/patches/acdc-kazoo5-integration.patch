+-spec force_archive_data() -> 'ok' | {'error', atom()}.
 force_archive_data() ->
+    %% Snapshot while the owner/heirs are still alive. The worker receives only
+    %% immutable copies and must finish (or be killed) before terminate returns.
+    Statuses = acdc_agent_stats:archive_status_snapshot(),
+    Calls = ets:select(call_table_id(), archive_call_match()),
     Self = self(),
-    _ = kz_process:spawn(fun archive_call_data/2, [Self, 'true']),
-    _ = kz_process:spawn(fun acdc_agent_stats:archive_status_data/2, [Self, 'true']),
+    Tag = make_ref(),
+    {Pid, Ref} = spawn_monitor(fun() ->
+        StatusSaved = acdc_agent_stats:archive_status_snapshot(Self, Statuses),
+        CallSaved = archive_call_snapshot(Self, Calls),
+        Self ! {Tag, StatusSaved =:= length(Statuses) andalso CallSaved =:= length(Calls)}
+    end),
+    Timeout = max(100, min(12000, kapps_config:get_integer(?CONFIG_CAT, <<"stats_shutdown_flush_ms">>, 10000))),
+    wait_archive(Pid, Ref, Tag, erlang:monotonic_time('millisecond') + Timeout).
+
+-spec wait_archive(pid(), reference(), reference(), integer()) -> 'ok' | {'error', atom()}.
+wait_archive(Pid, Ref, Tag, Deadline) ->
+    Remaining = max(0, Deadline - erlang:monotonic_time('millisecond')),
+    receive
+        {'$gen_cast', {'$client_cast', {'archive_status_saved', Stat}}} ->
+            mark_status_archived(Stat), wait_archive(Pid, Ref, Tag, Deadline);
+        {'$gen_cast', {'$client_cast', {'archive_call_saved', Stat}}} ->
+            mark_call_archived(Stat), wait_archive(Pid, Ref, Tag, Deadline);
+        {Tag, 'true'} -> erlang:demonitor(Ref, ['flush']), 'ok';
+        {Tag, 'false'} ->
+            erlang:demonitor(Ref, ['flush']),
+            lager:error("ACDC shutdown archive incomplete; latest statuses are NOT guaranteed durable"),
+            {'error', 'incomplete'};
+        {'DOWN', Ref, 'process', Pid, _Reason} ->
+            lager:error("ACDC shutdown archive worker failed before persistence completed"),
+            {'error', 'worker_failed'}
+    after Remaining ->
+        exit(Pid, 'kill'),
+        receive {'DOWN', Ref, 'process', Pid, _} -> 'ok' after 1000 -> erlang:demonitor(Ref, ['flush']) end,
+        lager:error("ACDC shutdown archive timed out; latest statuses are NOT guaranteed durable"),
+        {'error', 'timeout'}
+    end.
+
+-spec mark_status_archived(status_stat()) -> 'ok'.
+mark_status_archived(#status_stat{key=Key}=Snapshot) ->
+    case ets:lookup(acdc_agent_stats:status_table_id(), Key) of
+        [Snapshot] -> ets:update_element(acdc_agent_stats:status_table_id(), Key, {#status_stat.is_archived, 'true'});
+        _ -> 'false'
+    end,
+    'ok'.
+
+-spec mark_call_archived(call_stat()) -> 'ok'.
