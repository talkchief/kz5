+%% The stats API groups each agent's history by timestamp, rather than
+%% returning one flat status document. Display only its newest valid sample.
+%% Keep compatibility with flat legacy responses without inventing a date.
+current_status_rows(Agents) ->
+    [kz_json:set_value(<<"agent_id">>, AgentId, Stat)
+     || {AgentId, History} <- kz_json:to_proplist(Agents),
+        kz_json:is_json_object(History),
+        Stat <- latest_status(History)
+    ].
+
+latest_status(History) ->
+    case kz_json:get_ne_binary_value(<<"status">>, History) of
+        'undefined' ->
+            Samples = [{Timestamp, Stat}
+                       || Stat <- kz_json:values(History),
+                          kz_json:is_json_object(Stat),
+                          Timestamp <- [kz_json:get_integer_value(<<"timestamp">>, Stat)],
+                          is_integer(Timestamp), Timestamp >= 0,
+                          kz_json:get_ne_binary_value(<<"status">>, Stat) =/= 'undefined'
+                      ],
+            case Samples of
+                [] -> [];
+                _ -> {_Timestamp, Latest} = lists:max(Samples), [Latest]
+            end;
+        _ -> [History]
+    end.
+
