+%% Resolve fixed defaults exactly once before starting the scheduler. No prompt
+%% lookup or account-override query is made on recurring announcement ticks.
+-spec resolve_media(map(), kapps_call:call()) -> map().
+resolve_media(Config, Call) ->
+    Language = acdc_gemini_prompts:canonical(kapps_call:language(Call)),
+    Account = kapps_call:account_id(Call),
+    Position = resolve_position(Config, Language, Account),
+    Wait = resolve_wait(Config, Language, Account),
+    Callback = case maps:get(callback_announcements_enabled, Config) of
+                   'false' -> 'unavailable';
+                   'true' -> acdc_gemini_prompts:callback(
+                               maps:get(callback_entry_key, Config),
+                               maps:get(callback_allow_alternate, Config),
+                               maps:get(callback_media, Config), Language, Account)
+               end,
+    Config#{resolved_position => Position, resolved_wait => Wait,
+            non_gemini_position_dependency => Position =/= 'unavailable',
+            resolved_callback => Callback}.
+
+-spec resolve_position(map(), binary(), binary()) -> any().
+resolve_position(#{position_announcements_enabled := 'false'}, _, _) -> 'unavailable';
+resolve_position(Config, Language, Account) ->
+    Prefix = resolve_queue_prompt(<<"you_are_at_position">>, Config, Language, Account),
+    Suffix = resolve_queue_prompt(<<"in_the_queue">>, Config, Language, Account),
+    case {Prefix, Suffix} of
+        {{'gemini', _}, {'gemini', _}} when Language =:= <<"en-us">> ->
+            case acdc_gemini_prompts:default(<<"acdc-queue-your-current-position-is">>, Language, Account, 'absent') of
+                {Kind, Prompt} when Kind =:= 'gemini'; Kind =:= 'custom' -> {'ok', Prompt, 'undefined'};
+                _ -> 'unavailable'
+            end;
+        {{K1, P1}, {K2, P2}} when (K1 =:= 'gemini' orelse K1 =:= 'custom')
+                                      andalso (K2 =:= 'gemini' orelse K2 =:= 'custom')
+                                      andalso (K1 =:= 'custom' orelse K2 =:= 'custom') ->
+            %% Explicit queue fields and legacy account recordings retain the
+            %% two-part playlist; equality to a stock name is not ownership.
+            {'ok', P1, P2};
+        _ -> 'unavailable'
     end.
 
+-spec resolve_wait(map(), binary(), binary()) -> any().
+resolve_wait(#{wait_time_announcements_enabled := 'false'}, _, _) -> 'unavailable';
