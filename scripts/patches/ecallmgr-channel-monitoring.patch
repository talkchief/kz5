diff --git a/src/ecallmgr_call_monitor.erl b/src/ecallmgr_call_monitor.erl
new file mode 100644
index 0000000..790be6a
--- /dev/null
+++ b/src/ecallmgr_call_monitor.erl
@@ -0,0 +1,159 @@
+%%% Narrow account/correlation guard for Crossbar supervisor calls.
+%%% This Source Code Form is subject to the Mozilla Public License, v. 2.0.
+-module(ecallmgr_call_monitor).
+-export([guard/2, operation/1, stop/2, action/1, ready_headers/1, execute_matches/2]).
+-ifdef(TEST).
+-export([matches_channel/3, valid_request/2]).
+-endif.
+-include("ecallmgr.hrl").
+
+-spec operation(kz_json:object()) -> any().
+operation(J) -> kz_json:get_value(<<"Monitor-Operation">>, J).
+
+-spec guard(atom(), kz_json:object()) -> boolean().
+guard(Node, J) ->
+    case operation(J) of
+        'undefined' -> 'true';
+        <<"start">> -> valid_request(Node, J) andalso live_matches(Node, J, 'target');
+        _ -> 'false'
+    end.
+
+-spec valid_request(atom(), kz_json:object()) -> boolean().
+valid_request(Node, J) ->
+    Account = kz_json:get_value(<<"Monitor-Account-ID">>, J),
+    Request = kz_json:get_value(<<"Monitor-Request-ID">>, J),
+    Supervisor = kz_json:get_value(<<"Outbound-Call-ID">>, J),
+    Target = kz_json:get_value(<<"Eavesdrop-Call-ID">>, J),
+    Op = operation(J),
+    Base = kz_json:get_value(<<"Switch-Nodename">>, J) =:= kz_term:to_binary(Node)
+        andalso kz_json:get_value(<<"Application-Name">>, J) =:= <<"eavesdrop">>
+        andalso hex_id(Account) andalso hex_id(Request) andalso safe_id(Target) andalso hex_id(Supervisor)
+        andalso kz_json:get_value(<<"Originate-UUID">>, J) =:= Supervisor
+        andalso kz_api:msg_id(J) =:= Request
+        andalso kz_json:get_value(<<"Existing-Call-ID">>, J) =:= 'undefined'
+        andalso kz_json:get_value(<<"Eavesdrop-Group-ID">>, J) =:= 'undefined',
+    Base andalso case Op of
+        <<"start">> ->
+            CCVs = kz_json:get_value(<<"Custom-Channel-Vars">>, J, kz_json:new()),
+            Device = kz_json:get_value(<<"Monitor-Device-ID">>, J),
+            Mode = kz_json:get_value(<<"Eavesdrop-Mode">>, J),
+            Timeout = kz_json:get_value(<<"Timeout">>, J),
+            Target =/= Supervisor andalso hex_id(Device)
+                andalso lists:member(Mode, [<<"listen">>, <<"whisper">>, <<"full">>])
+                andalso kz_json:get_value(<<"Originate-Immediate">>, J) =:= 'false'
+                andalso is_integer(Timeout) andalso Timeout >= 5 andalso Timeout =< 60
+                andalso kz_json:get_value(<<"Account-ID">>, CCVs) =:= Account
+                andalso kz_json:get_value(<<"Authorizing-ID">>, CCVs) =:= Device
+                andalso kz_json:get_value(<<"Monitor-Request-ID">>, CCVs) =:= Request
+                andalso kz_json:get_value(<<"Monitor-Target-ID">>, CCVs) =:= Target
+                andalso safe_endpoint(kz_json:get_value(<<"Endpoints">>, J), Supervisor);
+        <<"stop">> -> Supervisor =:= Target;
+        _ -> 'false'
+    end.
+
+-spec safe_endpoint(any(), binary()) -> boolean().
+safe_endpoint([Endpoint], Supervisor) ->
+    Keys = [<<"Invite-Format">>, <<"Endpoint-Type">>, <<"To-User">>, <<"To-Username">>, <<"To-Realm">>
+            ,<<"Ignore-Early-Media">>, <<"Bypass-Media">>, <<"Outbound-Call-ID">>],
+    kz_json:get_keys(Endpoint) -- Keys =:= []
+        andalso kz_json:get_value(<<"Invite-Format">>, Endpoint) =:= <<"username">>
+        andalso kz_json:get_value(<<"Endpoint-Type">>, Endpoint) =:= <<"sip">>
+        andalso kz_json:get_value(<<"Outbound-Call-ID">>, Endpoint) =:= Supervisor
+        andalso matches(kz_json:get_value(<<"To-Username">>, Endpoint), <<"^[A-Za-z0-9_.+-]{1,128}$">>)
+        andalso kz_json:get_value(<<"To-User">>, Endpoint) =:= kz_json:get_value(<<"To-Username">>, Endpoint)
+        andalso matches(kz_json:get_value(<<"To-Realm">>, Endpoint), <<"^[A-Za-z0-9.-]{1,253}$">>);
+safe_endpoint(_, _) -> 'false'.
+
+-spec live_matches(atom(), kz_json:object(), atom()) -> boolean().
+live_matches(Node, J, Kind) ->
+    Id = kz_json:get_value(<<"Eavesdrop-Call-ID">>, J),
+    try freeswitch:api(Node, 'uuid_dump', Id) of
+        {'ok', Dump} -> matches_channel(J, Kind, dump_props(Dump));
+        _ -> 'false'
+    catch _:_ -> 'false'
+    end.
+
+%% uuid_dump contains optional empty headers and values with colons. Parse only
+%% the security fields and split on the first separator, not string:tokens/2.
+-spec dump_props(binary()) -> kz_term:proplist().
+dump_props(Dump) ->
+    Keys = [<<"Unique-ID">>, <<"Channel-State">>, ?GET_CCV(<<"Account-ID">>)
+            ,?GET_CCV(<<"Monitor-Request-ID">>), ?GET_CCV(<<"Monitor-Target-ID">>)
+            ,?GET_CCV(<<"Monitor-Mode">>)],
+    [{K, kz_http_util:urldecode(V)} || Line <- binary:split(Dump, <<"\n">>, ['global'])
+                                   ,[K,V] <- [binary:split(Line, <<": ">>)]
+                                   ,lists:member(K, Keys)].
+
+-spec matches_channel(kz_json:object(), atom(), kz_term:proplist()) -> boolean().
+matches_channel(J, Kind, Props) ->
+    Account = kz_json:get_value(<<"Monitor-Account-ID">>, J),
+    Id = kz_json:get_value(<<"Eavesdrop-Call-ID">>, J),
+    Base = props:get_value(<<"Unique-ID">>, Props) =:= Id
+        andalso props:get_value(?GET_CCV(<<"Account-ID">>), Props) =:= Account
+        andalso lists:member(props:get_value(<<"Channel-State">>, Props)
+                             ,[<<"CS_NEW">>, <<"CS_INIT">>, <<"CS_ROUTING">>, <<"CS_SOFT_EXECUTE">>
+                              ,<<"CS_EXECUTE">>, <<"CS_EXCHANGE_MEDIA">>, <<"CS_PARK">>
+                              ,<<"CS_CONSUME_MEDIA">>, <<"CS_HIBERNATE">>, <<"CS_RESET">>]),
+    Base andalso case Kind of
+        'target' -> 'true';
+        'supervisor' ->
+            props:get_value(?GET_CCV(<<"Monitor-Request-ID">>), Props) =:= kz_json:get_value(<<"Monitor-Request-ID">>, J)
+                andalso props:get_value(?GET_CCV(<<"Monitor-Target-ID">>), Props) =/= Id
+                andalso safe_id(props:get_value(?GET_CCV(<<"Monitor-Target-ID">>), Props))
+                andalso lists:member(props:get_value(?GET_CCV(<<"Monitor-Mode">>), Props), [<<"listen">>, <<"whisper">>, <<"full">>])
+    end.
+
+-spec stop(atom(), kz_json:object()) -> 'ok'.
+stop(Node, J) ->
+    Id = kz_json:get_value(<<"Outbound-Call-ID">>, J),
+    Result = case valid_request(Node, J) andalso live_matches(Node, J, 'supervisor') of
+        'true' ->
+            case freeswitch:api(Node, 'uuid_kill', <<Id/binary, " NORMAL_CLEARING">>) of
+                {'ok', <<"+OK", _/binary>>} -> <<"MONITOR_STOPPED">>;
+                _ -> <<"MONITOR_STOP_FAILED">>
+            end;
+        'false' -> <<"MONITOR_STOP_DENIED">>
+    end,
+    Resp = [{<<"Call-ID">>, Id}, {<<"Msg-ID">>, kz_api:msg_id(J)}
+            ,{<<"Monitor-Request-ID">>, kz_json:get_value(<<"Monitor-Request-ID">>, J)}
+            ,{<<"Application-Response">>, Result} | kz_api:default_headers(?APP_NAME, ?APP_VERSION)],
+    kapi_resource:publish_originate_resp(kz_api:server_id(J), Resp).
+
+%% WRITE mixes into audio sent toward the exact selected target leg (agent).
+%% READ would leak supervisor speech toward that leg's bridged customer.
+%% Fixed channel variables replace delayed synthetic DTMF and forbid escalation.
+-spec action(kz_json:object()) -> binary().
+action(J) ->
+    Target = kz_json:get_value(<<"Eavesdrop-Call-ID">>, J),
+    {Read, Write} = case kz_json:get_value(<<"Eavesdrop-Mode">>, J) of
+        <<"listen">> -> {<<"false">>, <<"false">>};
+        <<"whisper">> -> {<<"false">>, <<"true">>};
+        <<"full">> -> {<<"true">>, <<"true">>}
+    end,
+    <<"set:eavesdrop_enable_dtmf=false,set:eavesdrop_bridge_aleg=true,set:eavesdrop_bridge_bleg=true,"
+      "set:eavesdrop_whisper_aleg=", Read/binary, ",set:eavesdrop_whisper_bleg=", Write/binary,
+      ",eavesdrop:", Target/binary, " inline">>.
+
+-spec ready_headers(kz_json:object()) -> kz_term:proplist().
+ready_headers(J) ->
+    case operation(J) of
+        <<"start">> -> [{<<"Monitor-Verified">>, 'true'}, {<<"Monitor-Request-ID">>, kz_json:get_value(<<"Monitor-Request-ID">>, J)}];
+        _ -> []
+    end.
+
+-spec execute_matches(kz_json:object(), kz_json:object()) -> boolean().
+execute_matches(J, Execute) ->
+    case operation(J) of
+        'undefined' -> 'true';
+        <<"start">> -> kz_json:get_value(<<"Originate-UUID">>, Execute) =:= kz_json:get_value(<<"Originate-UUID">>, J)
+            andalso kz_api:msg_id(Execute) =:= kz_json:get_value(<<"Monitor-Request-ID">>, J);
+        _ -> 'false'
+    end.
+
+-spec safe_id(any()) -> boolean().
+safe_id(V) -> matches(V, <<"^[A-Za-z0-9_.:@-]{1,128}$">>).
+-spec hex_id(any()) -> boolean().
+hex_id(V) -> matches(V, <<"^[a-f0-9]{32}$">>).
+-spec matches(any(), binary()) -> boolean().
+matches(V, Regex) when is_binary(V) -> re:run(V, Regex, [{'capture', 'none'}]) =:= 'match';
+matches(_, _) -> 'false'.
