--spec originate_execute_async(pid(), atom(), kz_term:ne_binary(), kz_term:ne_binary()) ->
+-spec originate_execute_async(pid(), atom(), kz_term:ne_binary(), kz_term:ne_binary(), kz_json:object()) ->
           {'originate_result', freeswitch:fs_api_return()}.
-originate_execute_async(Pid, Node, UUID, Dialstrings) ->
-    Arg = list_to_binary([UUID, " ", Dialstrings]),
+originate_execute_async(Pid, Node, UUID, Dialstrings, Request) ->
+    RequestId = kz_api:msg_id(Request),
+    CallerId = kz_json:get_ne_binary_value(<<"Outbound-Call-ID">>, Request),
+    Arg = originate_api_command(UUID, RequestId, CallerId, Dialstrings),
     Res = freeswitch:async_api(Node, 'kz_originate', Arg),
     Pid ! {'originate_result', Res}.
 
+%% v2 gives mod_kazoo the immutable correlation tuple before it registers the
+%% pending transaction. Legacy requests remain compatible but cannot later be
+%% proven settled by the recovery protocol.
+-spec originate_api_command(kz_term:ne_binary(), kz_term:api_binary(), kz_term:api_binary(),
+                            kz_term:ne_binary()) -> kz_term:ne_binary().
+originate_api_command(UUID, RequestId, CallerId, Dialstrings) ->
+    case safe_originate_token(UUID) andalso safe_originate_token(RequestId)
+        andalso safe_originate_token(CallerId) of
+        'true' -> list_to_binary(["v2 ", UUID, " ", RequestId, " ", CallerId, " ", Dialstrings]);
+        'false' -> list_to_binary([UUID, " ", Dialstrings])
+    end.
+
+-spec safe_originate_token(any()) -> boolean().
+safe_originate_token(Value) when is_binary(Value), byte_size(Value) > 0, byte_size(Value) =< 512 ->
+    lists:all(fun(Character) -> Character > 32 andalso Character =/= 127 end,
+              binary_to_list(Value));
+safe_originate_token(_) -> 'false'.
+
