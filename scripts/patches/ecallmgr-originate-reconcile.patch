+%% FreeSWITCH, not the ephemeral ecallmgr originate process, is the truth
+%% boundary. Every ecallmgr instance reports only what its currently connected
+%% media nodes can prove from the exact UUID/request/caller tuple.
+-spec handle_originate_reconcile(kz_json:object(), kz_term:proplist()) -> 'ok'.
+handle_originate_reconcile(JObj, _Props) ->
+    'true' = kapi_call:originate_reconcile_req_v(JObj),
+    UUID = kz_json:get_ne_binary_value(<<"Originate-UUID">>, JObj),
+    RequestId = kz_json:get_ne_binary_value(<<"Originate-Request-ID">>, JObj),
+    CallerId = kz_json:get_ne_binary_value(<<"Outbound-Call-ID">>, JObj),
+    Operation = kz_json:get_ne_binary_value(<<"Operation">>, JObj),
+    Result = case safe_reconcile_tokens([UUID, RequestId, CallerId]) of
+                 'true' ->
+                     Command = list_to_binary([Operation, " ", UUID, " ", RequestId, " ", CallerId]),
+                     aggregate_originate_reconcile(
+                       [query_originate_reconcile(Node, Command)
+                        || Node <- ecallmgr_fs_nodes:connected()]);
+                 'false' -> #{'status' => <<"unknown">>, 'detail' => <<"invalid_correlation">>}
+             end,
+    Resp = props:filter_undefined(
+             [{<<"Originate-UUID">>, UUID}
+             ,{<<"Originate-Request-ID">>, RequestId}
+             ,{<<"Outbound-Call-ID">>, CallerId}
+             ,{<<"Operation">>, Operation}
+             ,{<<"Status">>, maps:get('status', Result)}
+             ,{<<"Media-Node">>, maps:get('media_node', Result, 'undefined')}
+             ,{<<"Module-Epoch">>, maps:get('module_epoch', Result, 'undefined')}
+             ,{<<"Outcome">>, maps:get('outcome', Result, 'undefined')}
+             ,{<<"Result-Call-ID">>, maps:get('result_call_id', Result, 'undefined')}
+             ,{<<"Failure-Cause">>, maps:get('failure_cause', Result, 'undefined')}
+             ,{<<"Detail">>, maps:get('detail', Result, 'undefined')}
+             ,{<<"Msg-ID">>, kz_api:msg_id(JObj)}
+              | kz_api:default_headers(?APP_NAME, ?APP_VERSION)]),
+    kapi_call:publish_originate_reconcile_resp(kz_api:server_id(JObj), Resp).
+
+-spec query_originate_reconcile(atom(), kz_term:ne_binary()) -> map().
+query_originate_reconcile(Node, Command) ->
+    Result = try freeswitch:api(Node, 'kz_originate_reconcile', Command)
+             catch _:_ -> {'error', 'query_failed'}
+             end,
+    parse_originate_reconcile(kz_term:to_binary(Node), Result).
+
+-spec parse_originate_reconcile(kz_term:ne_binary(), any()) -> map().
+parse_originate_reconcile(Node, {'ok', Reply}) when is_binary(Reply) ->
+    Tokens = binary:split(Reply, [<<" ">>, <<"\t">>, <<"\r">>, <<"\n">>]
+                         ,['global', 'trim_all']),
+    parse_originate_reconcile_tokens(Node, Tokens);
+parse_originate_reconcile(Node, _) ->
+    #{'status' => <<"unknown">>, 'media_node' => Node, 'detail' => <<"switch_query_failed">>}.
+
+-spec parse_originate_reconcile_tokens(kz_term:ne_binary(), [binary()]) -> map().
+parse_originate_reconcile_tokens(Node, [<<"+OK">>, <<"PENDING">>, Epoch]) ->
+    #{'status' => <<"pending">>, 'media_node' => Node, 'module_epoch' => Epoch};
+parse_originate_reconcile_tokens(Node, [<<"+OK">>, <<"SETTLED">>, <<"success">>, Epoch, CallId]) ->
+    #{'status' => <<"settled">>, 'media_node' => Node, 'module_epoch' => Epoch
+     ,'outcome' => <<"success">>, 'result_call_id' => CallId};
+parse_originate_reconcile_tokens(Node, [<<"+OK">>, <<"SETTLED">>, <<"failure">>, Epoch, Cause]) ->
+    #{'status' => <<"settled">>, 'media_node' => Node, 'module_epoch' => Epoch
+     ,'outcome' => <<"failure">>, 'failure_cause' => Cause};
+parse_originate_reconcile_tokens(Node, [<<"-ERR">>, <<"UNKNOWN">>, Epoch]) ->
+    #{'status' => <<"unknown">>, 'media_node' => Node, 'module_epoch' => Epoch
+     ,'detail' => <<"not_observed_in_module_epoch">>};
+parse_originate_reconcile_tokens(Node, [<<"-ERR">>, <<"CORRELATION_MISMATCH">>, Epoch]) ->
+    #{'status' => <<"unknown">>, 'media_node' => Node, 'module_epoch' => Epoch
+     ,'detail' => <<"correlation_mismatch">>};
+parse_originate_reconcile_tokens(Node, _) ->
+    #{'status' => <<"unknown">>, 'media_node' => Node, 'detail' => <<"invalid_switch_response">>}.
+
+%% At most one connected media node may claim a transaction. A second claim is
+%% conflict evidence, even if the text happens to match.
+-spec aggregate_originate_reconcile([map()]) -> map().
+aggregate_originate_reconcile(Results) ->
+    Authoritative = [Result || Result <- Results,
+                               maps:get('status', Result, <<"unknown">>) =/= <<"unknown">>],
+    case Authoritative of
+        [Result] -> Result;
+        [] -> #{'status' => <<"unknown">>, 'detail' => <<"no_authoritative_transaction">>};
+        _ -> #{'status' => <<"unknown">>, 'detail' => <<"conflicting_media_nodes">>}
+    end.
+
+-spec safe_reconcile_tokens([any()]) -> boolean().
+safe_reconcile_tokens(Tokens) ->
+    lists:all(fun(Token) when is_binary(Token), byte_size(Token) > 0, byte_size(Token) =< 512 ->
+                      lists:all(fun(Character) -> Character > 32 andalso Character =/= 127 end,
+                                binary_to_list(Token));
+                 (_) -> 'false'
+              end, Tokens).
+
