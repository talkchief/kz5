+%% The master has no ancestors. System capabilities already supply the master
+%% layer; skip that first ancestor for descendants without calling tl([]).
+-spec reseller_ancestors(kz_term:ne_binaries()) -> kz_term:ne_binaries().
+reseller_ancestors([]) -> [];
+reseller_ancestors([_Master | Resellers]) -> Resellers.
+
 -spec calculate_entitlements([kzd_entitlements:doc()] | kz_term:ne_binaries()) -> kzd_entitlements:doc().
