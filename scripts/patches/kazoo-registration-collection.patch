 -spec search_realm_regs(Realm::kz_term:ne_binary(), SearchType::kz_term:ne_binary()) ->
-          kz_term:ne_binaries() | kz_json:objects().
+          kz_term:ne_binaries() | kz_json:objects() | {'error', any()}.
 search_realm_regs(AccountRealm, SearchType) ->
