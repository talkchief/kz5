diff --git a/src/switch_core_session.c b/src/switch_core_session.c
--- a/src/switch_core_session.c
+++ b/src/switch_core_session.c
@@ -37,3 +37,29 @@
 #include "switch_core.h"
 #include "private/switch_core_pvt.h"
+#include <errno.h>
+#include <sys/stat.h>
+
+/* Durable Kazoo maintenance admission, independent of fsctl pause/resume.
+ * Check inside session_hash_mutex: a matching native observation cannot
+ * overtake a previously admitted allocation before it enters session_table.
+ * Missing intent is open; all other filesystem errors fail closed.
+ * The root helper owns the directory/marker. No per-account data lives here. */
+static int kazoo_maintenance_marker_state(void)
+{
+	struct stat st;
+	if (lstat("/etc/kazoo5-maintenance", &st) != 0) {
+		return errno == ENOENT ? 0 : -1;
+	}
+	if (!S_ISDIR(st.st_mode) || st.st_uid != 0 || (st.st_mode & 0777) != 0755) {
+		return -1;
+	}
+	if (lstat("/etc/kazoo5-maintenance/media.closed", &st) != 0) {
+		return errno == ENOENT ? 0 : -1;
+	}
+	if (!S_ISREG(st.st_mode) || st.st_uid != 0 || st.st_nlink != 1 ||
+		(st.st_mode & 0777) != 0644 || st.st_size <= 0 || st.st_size > 512) {
+		return -1;
+	}
+	return 1;
+}
 
