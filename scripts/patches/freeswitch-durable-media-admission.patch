diff --git a/src/switch_core_session.c b/src/switch_core_session.c
--- a/src/switch_core_session.c
+++ b/src/switch_core_session.c
@@ -2530,5 +2530,16 @@
 SWITCH_DECLARE(uint32_t) switch_core_session_count(void)
 {
 	return session_manager.session_count;
 }
+
+/* Read-only barrier, not a setter and not a broker/callback drain assertion. */
+SWITCH_DECLARE(int) switch_core_session_maintenance_check(uint32_t *sessions)
+{
+	int state;
+	switch_mutex_lock(runtime.session_hash_mutex);
+	state = kazoo_maintenance_marker_state();
+	*sessions = session_manager.session_count;
+	switch_mutex_unlock(runtime.session_hash_mutex);
+	return state;
+}
 
