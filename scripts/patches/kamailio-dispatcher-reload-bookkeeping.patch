+# Read immediately after successful DML, on the same process-local connection.
+# SQLite has no DB_CAP_AFFECTED_ROWS; successful INSERT ... WHERE NOT EXISTS
+# can still change zero rows. Never turn a duplicate advertisement into a reload.
+route[DISPATCHER_READ_CHANGED_ROWS]
+{
+    $var(dispatcher_changed_rows) = -1;
+    #!ifdef KZ_DISPATCHER_SQLITE_AFFECTED_ROWS
+    if (sql_pvquery("exec", "select changes()", "$var(dispatcher_changed_rows)") != 1) {
+        # The DML already succeeded: preserve an uncertain change for retry.
+        $shv(dispatcher_reload) = 1;
+        xlog("L_ERR", "cannot read dispatcher changed-row count; reload retained\n");
+        return -1;
+    }
+    #!else
+    $var(dispatcher_changed_rows) = $sqlrows(exec);
+    #!endif
+    if ($var(dispatcher_changed_rows) < 0) {
+        $shv(dispatcher_reload) = 1;
+        xlog("L_ERR", "invalid dispatcher changed-row count; reload retained\n");
+        return -1;
+    }
+    return 1;
+}
