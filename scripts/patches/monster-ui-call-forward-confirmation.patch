+		getForwardedCallConfirmationStrings: function() {
+			return _.defaults({}, _.get(this.i18n.active(), 'callflows.accountSettings.forwardConfirmation', {}), {
+				title: 'Forwarded-call confirmation',
+				help: 'Choose the language recipients hear before pressing 1 to accept a forwarded call.',
+				language: 'Confirmation language',
+				current: 'Default (existing prompt)',
+				save: 'Save language',
+				saving: 'Saving…',
+				saved: 'Saved. New forwarded calls will use this choice.',
+				accountSaved: 'Account settings saved.',
+				updateFailed: 'Could not confirm the update. Your changes remain on this screen.',
+				failed: 'Could not confirm the saved language. Reload Account Settings before trying again.'
+			});
+		},
+
+		bindForwardedCallConfirmation: function(template, data) {
+			var self = this,
+				section = template.find('.forward-confirmation-settings'),
+				select = section.find('.forward-confirmation-language'),
+				save = section.find('.forward-confirmation-save'),
+				status = section.find('.forward-confirmation-status'),
+				accountSave = template.find('.account-settings-update'),
+				accountId = data.account.id,
+				current = _.get(data.account, 'call_forward_confirmation.language', ''),
+				strings = self.getForwardedCallConfirmationStrings(),
+				languages = ['', 'en-us', 'he-il', 'ar-sa', 'es-es', 'fr-fr'],
+				busy = false,
+				wasDisabled,
+				pendingAccountLanguage;
+
+			if (!monster.util.isAdmin() && !monster.util.isSuperDuper()) {
+				section.remove();
+				return;
+			}
+			function active() {
+				return self.accountId === accountId && template.closest('html').length > 0;
+			}
+			function start() {
+				busy = true;
+				wasDisabled = accountSave.prop('disabled');
+				select.prop('disabled', true);
+				save.prop('disabled', true);
+				accountSave.prop('disabled', true);
+				status.text(strings.saving);
+			}
+			function finish(message) {
+				busy = false;
+				if (!active()) { return; }
+				select.prop('disabled', false);
+				save.prop('disabled', select.val() === current);
+				accountSave.prop('disabled', wasDisabled);
+				status.text(message);
+			}
+			function updatePreference(returned) {
+				current = returned;
+				select.val(current);
+				if (current) {
+					data.account.call_forward_confirmation = { language: current };
+				} else {
+					delete data.account.call_forward_confirmation;
+				}
+			}
+			select.val(current);
+			save.prop('disabled', true);
+			select.on('change', function() {
+				status.text('');
+				save.prop('disabled', busy || select.val() === current);
+			});
+			template.data('forwardConfirmation', {
+				prepareUpdate: function(newData) {
+					var selected = select.val();
+					if (busy || !active() || !_.includes(languages, selected)) { return false; }
+					// Only a changed selection may replace a newer preference from another client.
+					delete newData.call_forward_confirmation;
+					pendingAccountLanguage = selected !== current ? selected : undefined;
+					if (pendingAccountLanguage !== undefined) {
+						newData.call_forward_confirmation = { language: selected || null };
+					}
+					start();
+					return true;
+				},
+				updateSucceeded: function(response) {
+					if (!active()) { busy = false; return; }
+					var returned = _.get(response, 'data.call_forward_confirmation.language', '');
+					if (!response.data || !_.includes(languages, returned) ||
+						(pendingAccountLanguage !== undefined && returned !== pendingAccountLanguage)) {
+						finish(strings.updateFailed);
+						return;
+					}
+					data.account = response.data;
+					updatePreference(returned);
+					finish(strings.accountSaved);
+				},
+				updateFailed: function() { finish(strings.updateFailed); }
+			});
+			save.on('click', function() {
+				var selected = select.val();
+				if (busy || !active() || selected === current || !_.includes(languages, selected)) {
+					return;
+				}
+				start();
+				self.callApi({
+					resource: 'account.patch',
+					data: { accountId: accountId, data: { call_forward_confirmation: { language: selected || null } } },
+					success: function(response) {
+						if (!active()) { busy = false; return; }
+						var returned = _.get(response, 'data.call_forward_confirmation.language', '');
+						if (returned !== selected) { finish(strings.failed); return; }
+						updatePreference(returned);
+						finish(strings.saved);
+					},
+					error: function() { finish(strings.failed); }
+				});
 			});
 		},
 
