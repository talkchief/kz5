diff --git a/kazoo_auth/src/kz_auth_identity.erl b/kazoo_auth/src/kz_auth_identity.erl
--- a/kazoo_auth/src/kz_auth_identity.erl
+++ b/kazoo_auth/src/kz_auth_identity.erl
@@ -144,11 +144,17 @@ get_identity_secret(#{auth_provider := #{name := <<"kazoo">>}
                      ,auth_db := Db
                      ,auth_id := Key
                      }=Token) ->
-    case kz_datamgr:open_cache_doc(Db, Key) of
+    %% Signing-secret revocation must not depend on AMQP cache invalidation.
