# SOURCE-REVIEW EXAMPLE ONLY; intentionally incomplete and not activation-ready.
# Copy outside the repository only after activation gates in README are closed.
# Protect config and credential files; never commit their populated contents.
# Required for bridge startup. Use operator-reviewed broker and FCM settings.
PUSH_BRIDGE_SA_FILE=
PUSH_BRIDGE_AMQP_HOST=
PUSH_BRIDGE_AMQP_USER=
PUSH_BRIDGE_AMQP_PASS=
PUSH_BRIDGE_AMQP_VHOST=
PUSH_BRIDGE_EXCHANGE=pushes
PUSH_BRIDGE_QUEUE=
PUSH_BRIDGE_BINDING_KEY=
PUSH_BRIDGE_FCM_SCOPE=
# Python str.format template; use {project_id} for the service-account project.
PUSH_BRIDGE_FCM_URL_TEMPLATE=

# Optional generic transport/tuning defaults retained from the supplied source.
# Remote secure brokers: set true and port5671 (or reviewed explicit TLS port).
# Port alone never enables TLS. Absent port defaults to5671 with TLS, else5672.
PUSH_BRIDGE_AMQP_TLS=false
PUSH_BRIDGE_AMQP_PORT=5672
# Optional custom trust bundle, only with AMQP_TLS=true. Omit for system roots.
# Protected root-owned service-directory PEM; no private key or hostname override.
# PUSH_BRIDGE_AMQP_CA_FILE=/etc/kazoo-push-bridge/broker-ca.pem
PUSH_BRIDGE_WORKERS=32
PUSH_BRIDGE_APNS_WORKERS=8
PUSH_BRIDGE_STALL_TIMEOUT=70

# Required to initialize APNs. TOPIC is the base bundle topic, WITHOUT .voip.
PUSH_BRIDGE_APNS_KEY_FILE=
PUSH_BRIDGE_APNS_KEY_ID=
PUSH_BRIDGE_APNS_TEAM_ID=
PUSH_BRIDGE_APNS_TOPIC=
# Required for each used environment. Hostname only; TLS port is fixed at 443.
PUSH_BRIDGE_APNS_HOST_PROD=
PUSH_BRIDGE_APNS_HOST_DEV=
# Optional in the imported contract: when ABSENT these use the main key pair.
# Deliberately do not populate these with an embedded production identity.
# PUSH_BRIDGE_APNS_KEY_FILE_DEV=
# PUSH_BRIDGE_APNS_KEY_ID_DEV=

# Explicit command-line provider-test modes only; these perform REAL sends.
# Payload must be operator-provided JSON. Do not set in ordinary service config.
# PUSH_BRIDGE_TEST_PAYLOAD_JSON=
